{
  "manifest_version": 3,
  "name": "CubeTT",
  "description": "输入想法后自动优化为高质量提示词，支持模板库、本地导出，并可快捷存储和调用 AI 绘画提示词。",
  "version": "1.0.1",
  "icons": {
    "16": "icons/cubett-16.png",
    "32": "icons/cubett-32.png",
    "48": "icons/cubett-48.png",
    "128": "icons/cubett-128.png"
  },
  "action": {
    "default_title": "CubeTT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cubett-16.png",
      "32": "icons/cubett-32.png",
      "48": "icons/cubett-48.png",
      "128": "icons/cubett-128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "clipboardWrite",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
